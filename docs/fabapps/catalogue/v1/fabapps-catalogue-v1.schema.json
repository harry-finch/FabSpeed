{
  "type": "object",
  "properties": {
    "format": {
      "enum": [
        "fabapps-catalogue"
      ]
    },
    "version": {
      "enum": [
        1
      ]
    },
    "catalogue_id": {
      "type": "string",
      "pattern": "^fs-[0-9a-f]{32}$"
    },
    "publisher": {
      "type": "object",
      "properties": {
        "application": {
          "enum": [
            "fabspeed"
          ]
        },
        "application_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "application",
        "application_version"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]+)?Z$"
    },
    "complete": {
      "enum": [
        true
      ]
    },
    "language": {
      "enum": [
        "fr"
      ]
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/machines"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tools"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/materials"
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/presets"
      }
    }
  },
  "required": [
    "format",
    "version",
    "catalogue_id",
    "publisher",
    "revision",
    "generation",
    "published_at",
    "complete",
    "language",
    "machines",
    "tools",
    "materials",
    "presets"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabapps:catalogue:v1",
  "$defs": {
    "machines": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "machine_profile"
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "rpm_min": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "status": {
                  "enum": [
                    "verified",
                    "estimate",
                    "to_verify",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "status"
              ],
              "additionalProperties": false
            },
            "rpm_max": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "status": {
                  "enum": [
                    "verified",
                    "estimate",
                    "to_verify",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "status"
              ],
              "additionalProperties": false
            },
            "max_feed_mm_min": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "status": {
                  "enum": [
                    "verified",
                    "estimate",
                    "to_verify",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "status"
              ],
              "additionalProperties": false
            },
            "max_plunge_mm_min": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "status": {
                  "enum": [
                    "verified",
                    "estimate",
                    "to_verify",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "status"
              ],
              "additionalProperties": false
            },
            "spindle_power_w": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "status": {
                  "enum": [
                    "verified",
                    "estimate",
                    "to_verify",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "status"
              ],
              "additionalProperties": false
            },
            "spindle_rated_rpm": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "status": {
                  "enum": [
                    "verified",
                    "estimate",
                    "to_verify",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "status"
              ],
              "additionalProperties": false
            },
            "work_area_mm": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "status": {
                  "enum": [
                    "verified",
                    "estimate",
                    "to_verify",
                    "unknown"
                  ]
                }
              },
              "required": [
                "value",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "rpm_min",
            "rpm_max",
            "max_feed_mm_min",
            "spindle_power_w"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "kind",
        "limits"
      ],
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "tool_spec"
          ]
        },
        "family": {
          "enum": [
            "flat_endmill",
            "ball_nose",
            "compression",
            "v_bit",
            "diamond_cut",
            "surfacing"
          ]
        },
        "helix": {
          "enum": [
            "upcut",
            "downcut",
            "compression",
            "straight",
            "unknown"
          ]
        },
        "tool_material": {
          "enum": [
            "carbide",
            "hss"
          ]
        },
        "diameter_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "flute_length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shank_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "overall_length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "upcut_length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_rpm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "supplier_rpm_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "supplier_rpm_recommended": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "flutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "tip_angle_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "supplier": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "kind",
        "family",
        "helix",
        "tool_material",
        "diameter_mm",
        "flute_length_mm"
      ],
      "additionalProperties": false
    },
    "materials": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "material_profile"
          ]
        },
        "category": {
          "enum": [
            "wood",
            "panel",
            "plastic",
            "foam",
            "metal",
            "composite"
          ]
        },
        "supervision_required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "kind",
        "category",
        "supervision_required"
      ],
      "additionalProperties": false
    },
    "presets": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^trial:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "pattern": "^Validated preset [0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "validated"
          ]
        },
        "machine": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        "tool": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        "material": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "properties": {
            "operation": {
              "enum": [
                "profile",
                "pocket",
                "full_slot",
                "finish",
                "surfacing",
                "engraving"
              ]
            },
            "aggressiveness": {
              "enum": [
                "prudent",
                "normal",
                "rapid"
              ]
            },
            "workholding": {
              "enum": [
                "screws_clamps",
                "vacuum",
                "tape",
                "unknown"
              ]
            },
            "stepover_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "thickness_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stickout_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tool_condition": {
              "enum": [
                "new",
                "used"
              ]
            }
          },
          "required": [
            "operation",
            "aggressiveness",
            "workholding",
            "stepover_ratio"
          ],
          "additionalProperties": false
        },
        "values": {
          "type": "object",
          "properties": {
            "rpm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "feed_mm_min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "plunge_mm_min": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "doc_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "rpm",
            "feed_mm_min",
            "plunge_mm_min",
            "doc_mm"
          ],
          "additionalProperties": false
        },
        "validation": {
          "type": "object",
          "properties": {
            "basis": {
              "enum": [
                "admin_confirmed_good_trial"
              ]
            },
            "trial_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "tested_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]+)?Z$"
            },
            "validated_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]+)?Z$"
            },
            "dependency_binding": {
              "enum": [
                "captured_at_validation"
              ]
            }
          },
          "required": [
            "basis",
            "trial_id",
            "tested_at",
            "validated_at",
            "dependency_binding"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "status",
        "machine",
        "tool",
        "material",
        "context",
        "values",
        "validation"
      ],
      "additionalProperties": false
    }
  }
}
